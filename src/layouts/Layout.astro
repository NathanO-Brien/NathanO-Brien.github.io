---
import Nav from "../components/Nav.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	/** When true, the page is expected to fit one viewport with no scroll (homepage). */
	fitToViewport?: boolean;
	/** When true, main uses a wider max-width (for multi-column layouts like the hero). */
	wide?: boolean;
}

const {
	title,
	description = "Nathan O'Brien — aerospace engineer.",
	fitToViewport = false,
	wide = false,
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Nathan O'Brien</title>
	</head>
	<body class:list={[fitToViewport && "fit-to-viewport"]}>
		{
			/* Nav's 72rem is derived from main's 82rem max-width, hero's 69rem
			   width, and the shared 1.5rem (--space-5) padding-inline, so that
			   nav__home lines up with the hero text's left edge. Recompute if
			   any of those three values change. */
		}
		<header>
			<Nav maxWidth={wide ? "72rem" : undefined} />
		</header>
		<main class="container" style={wide ? "--max-width: 82rem" : undefined}>
			<slot />
		</main>
	</body>
</html>

<style>
	header {
		border-bottom: 1px solid var(--color-border);
	}

	main {
		padding-block: var(--space-7);
	}

	body.fit-to-viewport {
		height: 100dvh;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	body.fit-to-viewport main {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-block: var(--space-5);
		min-height: 0;
	}
</style>
