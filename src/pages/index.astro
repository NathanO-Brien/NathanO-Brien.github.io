---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import AnimatedButton from "../components/AnimatedButton.astro";
---

<Layout title="About" fitToViewport wide>
	<section class="hero">
		<div class="hero__text">
			<p class="eyebrow">Nathan O'Brien</p>
			<h1>[Header: one first-person sentence stating your profession]</h1>
			<p class="hero__paragraph">
				[Paragraph 1: a few sentences introducing yourself — background, what you're
				currently doing, first person.]
			</p>
			<p class="hero__paragraph">
				[Paragraph 2: a few more sentences — interests, what you're looking for, first
				person.]
			</p>

			<div class="hero__actions">
				<AnimatedButton href="/career/">Career progression</AnimatedButton>
				<AnimatedButton href="/projects/" variant="outline">Projects</AnimatedButton>
			</div>

			<div class="hero__social">
				<SocialLink label="LinkedIn" href="https://www.linkedin.com/in/nathano-brien/" icon="linkedin" />
				<SocialLink label="GitHub" href="https://github.com/NathanO-Brien" icon="github" />
				<SocialLink label="Email" href="mailto:nathanobrien261@gmail.com" icon="email" />
			</div>
		</div>

		<div class="hero__photo">
			<img src="/images/headshot.jpg" alt="Portrait of Nathan O'Brien" />
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: var(--space-7);
		width: 100%;
	}

	.hero__text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.hero__text h1 {
		font-size: var(--step-3);
		line-height: 1.15;
		letter-spacing: -0.01em;
		max-width: 32rem;
	}

	.hero__paragraph {
		max-width: 34rem;
		color: var(--color-muted);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.hero__social {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.hero__photo {
		flex-shrink: 0;
		width: 14rem;
		height: 14rem;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--color-border);
	}

	.hero__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
	}

	@media (max-width: 860px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-4);
		}

		.hero__photo {
			width: 7rem;
			height: 7rem;
			align-self: center;
		}

		.hero__text h1 {
			font-size: var(--step-2);
		}
	}
</style>
