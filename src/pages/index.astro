---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import AnimatedButton from "../components/AnimatedButton.astro";
---

<Layout title="About" fitToViewport wide>
	<section class="hero">
		<div class="hero__text">
			<p class="eyebrow">About</p>
			<h1>I am helping to build the <span class="highlight">future</span> of American commercial space.</h1>
			<p class="hero__paragraph">
				I'm a master's student in aerospace engineering at the{" "}
				<a href="https://www.gatech.edu/" target="_blank" rel="noopener noreferrer">Georgia Institute of Technology</a>
				{" "}and a consultant for the{" "}
				<a href="https://www.csis.org/" target="_blank" rel="noopener noreferrer">Center for Strategic and International Studies</a>.
				My focus lies in GNC engineering and space policy.
			</p>
			<p class="hero__paragraph">
				As a member of the{" "}
				<a href="https://espl.ae.gatech.edu/" target="_blank" rel="noopener noreferrer">Engineering Space Policy Laboratory</a>,
				I specialize in the space security field. I use my technical background to develop
				optimized constellation models for all types of space-based interceptor proposals.
				My academic work is funded through a philanthropic grant issued by{" "}
				<a href="https://www.longview.org/" target="_blank" rel="noopener noreferrer">Longview Philanthropy</a>
				{" "}and{" "}
				<a href="https://www.founderspledge.com/" target="_blank" rel="noopener noreferrer">Founder's Pledge</a>.
				My work has also been recognized by the{" "}
				<a href="https://nssaspace.org/" target="_blank" rel="noopener noreferrer">National Security Space Association</a>
				{" "}via the{" "}
				<a href="https://nssaspace.org/rgi-scholarship/" target="_blank" rel="noopener noreferrer">RGi Scholarship Award</a>.
			</p>

			<div class="hero__actions">
				<AnimatedButton href="/career/" class="tie-accent">Career</AnimatedButton>
				<AnimatedButton href="/docs/nathan-obrien-resume.pdf" variant="outline" data-resume-open>Resume</AnimatedButton>
			</div>

			<div class="hero__social">
				<SocialLink label="LinkedIn" href="https://www.linkedin.com/in/nathano-brien/" icon="linkedin" />
				<SocialLink label="GitHub" href="https://github.com/NathanO-Brien" icon="github" />
				<SocialLink label="Email" href="mailto:nathanobrien261@gmail.com" icon="email" />
			</div>
		</div>

		<div class="hero__photo">
			<img src="/images/headshot.jpg" alt="Portrait of Nathan O'Brien" />
		</div>
	</section>
</Layout>

<style>
	/* Width is the sum of its children: hero__paragraph max-width (48rem) +
	   gap (--space-7, 3rem) + hero__photo (18rem) = 69rem. Keep in sync with
	   Nav's "wide" max-width (Layout.astro) so both stay left-aligned. */
	.hero {
		display: flex;
		align-items: center;
		gap: var(--space-7);
		width: 69rem;
		max-width: 100%;
		margin-inline: auto;
	}

	.hero__text {
		flex: 0 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.hero__text h1 {
		font-size: var(--step-3);
		line-height: 1.15;
		letter-spacing: -0.01em;
		max-width: 44rem;
	}

	/* Tie-matched accent, sampled from the headshot: rgb(104, 120, 154).
	   Keep .highlight's underline and .tie-accent's --color-accent override
	   in sync if the photo ever changes. */
	.highlight {
		position: relative;
		white-space: nowrap;
	}

	.highlight::after {
		content: "";
		position: absolute;
		left: -2%;
		right: -4%;
		bottom: -0.25em;
		height: 0.4em;
		/* Two stacked curved streaks (each a filled shape with offset top/
		   bottom rails, since a plain stroke can't taper on its own): the
		   longer one on top spans the full word, a shorter second one sits
		   below it, starting farther left and ending a bit before the top
		   streak's right end. Both taper non-linearly -- a quick rise near
		   the start, a longer gradual thinning after -- and stay pointed
		   (never blunt/rounded) on both ends so neither reads as a circle. */
