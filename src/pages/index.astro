---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import AnimatedButton from "../components/AnimatedButton.astro";
---

<Layout title="About" fitToViewport>
	<section class="hero">
		<p class="eyebrow">Aerospace Engineering · GNC</p>
		<h1>Nathan O'Brien</h1>
		<p class="hero__summary">
			Second-year Aerospace Engineering master's student at Georgia Tech, focused on
			guidance, navigation, and control (GNC). Side interests in space policy and
			small business.
		</p>

		<div class="hero__actions">
			<AnimatedButton href="/career/">Career progression</AnimatedButton>
			<AnimatedButton href="/projects/" variant="outline">Projects</AnimatedButton>
		</div>

		<div class="hero__social">
			<SocialLink label="LinkedIn" href="https://www.linkedin.com/" icon="linkedin" />
			<SocialLink label="GitHub" href="https://github.com/NathanO-Brien" icon="github" />
			<SocialLink label="Email" href="mailto:nathanobrien261@gmail.com" icon="email" />
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.hero h1 {
		font-size: var(--step-4);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.hero__summary {
		max-width: 34rem;
		color: var(--color-muted);
		font-size: var(--step-1);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.hero__social {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}
</style>
