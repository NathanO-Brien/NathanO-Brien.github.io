---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import AnimatedButton from "../components/AnimatedButton.astro";
---

<Layout title="About" fitToViewport wide>
	<section class="hero">
		<div class="hero__text">
			<p class="eyebrow">About</p>
			<h1>I am helping to build the future of American commercial space.</h1>
			<p class="hero__paragraph">
				I'm a master's student in aerospace engineering at the{" "}
				<a href="https://www.gatech.edu/" target="_blank" rel="noopener noreferrer">Georgia Institute of Technology</a>
				{" "}and a consultant for the{" "}
				<a href="https://www.csis.org/" target="_blank" rel="noopener noreferrer">Center for Strategic and International Studies</a>.
				My focus lies in GNC engineering and space policy.
			</p>
			<p class="hero__paragraph">
				As a member of the{" "}
				<a href="https://espl.ae.gatech.edu/" target="_blank" rel="noopener noreferrer">Engineering Space Policy Laboratory</a>,
				I specialize in the space security field. I use my technical background to develop
				optimized constellation models for all types of space-based interceptor proposals.
				My academic work is funded through a philanthropic grant issued by{" "}
				<a href="https://www.longview.org/" target="_blank" rel="noopener noreferrer">Longview Philanthropy</a>
				{" "}and{" "}
				<a href="https://www.founderspledge.com/" target="_blank" rel="noopener noreferrer">Founder's Pledge</a>.
				My work has also been recognized by the{" "}
				<a href="https://nssaspace.org/" target="_blank" rel="noopener noreferrer">National Security Space Association</a>
				{" "}via the{" "}
				<a href="https://nssaspace.org/rgi-scholarship/" target="_blank" rel="noopener noreferrer">RGi Scholarship Award</a>.
			</p>

			<div class="hero__actions">
				<AnimatedButton href="/career/">Career progression</AnimatedButton>
				<AnimatedButton href="/projects/" variant="outline">Projects</AnimatedButton>
			</div>

			<div class="hero__social">
				<SocialLink label="LinkedIn" href="https://www.linkedin.com/in/nathano-brien/" icon="linkedin" />
				<SocialLink label="GitHub" href="https://github.com/NathanO-Brien" icon="github" />
				<SocialLink label="Email" href="mailto:nathanobrien261@gmail.com" icon="email" />
			</div>
		</div>

		<div class="hero__photo">
			<img src="/images/headshot.jpg" alt="Portrait of Nathan O'Brien" />
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: inline-flex;
		align-items: center;
		gap: var(--space-7);
		max-width: 100%;
	}

	.hero__text {
		flex: 0 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.hero__text h1 {
		font-size: var(--step-3);
		line-height: 1.15;
		letter-spacing: -0.01em;
		max-width: 44rem;
	}

	.hero__paragraph {
		max-width: 48rem;
		color: var(--color-muted);
	}

	.hero__paragraph a {
		color: var(--color-ink);
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.15em;
		transition: text-decoration-color 160ms var(--ease-snap), color 160ms var(--ease-snap);
	}

	.hero__paragraph a:hover,
	.hero__paragraph a:focus-visible {
		color: var(--color-accent);
		text-decoration-color: var(--color-accent);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.hero__social {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.hero__photo {
		flex-shrink: 0;
		width: 18rem;
		height: 18rem;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--color-border);
	}

	.hero__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1);
	}

	@media (max-width: 860px) {
		.hero {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-4);
			width: 100%;
		}

		.hero__text {
			width: 100%;
		}

		.hero__text h1,
		.hero__paragraph {
			max-width: 100%;
		}

		.hero__photo {
			width: 8rem;
			height: 8rem;
			align-self: center;
		}

		.hero__text h1 {
			font-size: var(--step-2);
		}
	}
</style>
