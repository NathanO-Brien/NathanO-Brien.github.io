16.6 L125.0,16.8 L127.1,16.9 L129.3,17.1 L131.4,17.2 L133.5,17.4 L135.7,17.5 L137.8,17.7 L139.9,17.9 L140.1,16.5 L137.9,16.3 L135.8,16.1 L133.7,15.8 L131.5,15.6 L129.4,15.4 L127.3,15.2 L125.1,15.0 L123.0,14.8 L120.8,14.6 L118.7,14.5 L116.6,14.3 L114.4,14.1 L112.3,13.9 L110.2,13.8 L108.0,13.6 L105.9,13.4 L103.8,13.3 L101.6,13.1 L99.5,13.0 L97.3,12.9 L95.2,12.7 L93.1,12.6 L90.9,12.5 L88.8,12.4 L86.7,12.3 L84.5,12.2 L82.4,12.0 L80.2,12.0 L78.1,11.9 L76.0,11.8 L73.8,11.7 L71.7,11.6 L69.6,11.5 L67.4,11.5 L65.3,11.4 L63.1,11.4 L61.0,11.3 L58.9,11.3 L56.7,11.2 L54.6,11.2 L52.4,11.1 L50.3,11.1 L48.2,11.1 L46.0,11.1 L43.9,11.1 L41.7,11.1 L39.6,11.1 L37.4,11.1 L35.3,11.1 L33.2,11.1 L31.0,11.3 L28.9,11.5 L26.7,11.7 L24.6,11.9 L22.5,12.1 L20.3,12.4 L18.2,12.6 L16.1,13.0 L14.0,13.5 Z' fill='%2368789A'/%3E%3C/svg%3E");
		background-repeat: no-repeat;
		background-size: 100% 100%;
		transform: rotate(-1deg);
		z-index: -1;
	}

	.hero__paragraph {
		max-width: 48rem;
		color: var(--color-muted);
	}

	.hero__paragraph a {
		color: var(--color-ink);
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.15em;
		transition: text-decoration-color 160ms var(--ease-snap), color 160ms var(--ease-snap);
	}

	.hero__paragraph a:hover,
	.hero__paragraph a:focus-visible {
		color: var(--color-accent);
		text-decoration-color: var(--color-accent);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-3);
	}

	:global(.tie-accent) {
		--color-accent: #68789a;
		--color-accent-ink: #ffffff;
	}

	.hero__social {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	.hero__photo {
		flex-shrink: 0;
		width: 18rem;
		height: 18rem;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--color-border);
	}

	.hero__photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Portrait-only: a landscape phone gets the plain desktop rules above
	   instead (per request, "the horizontal mobile layout [should be] the
	   same as desktop") -- .hero stays a row, nothing in this block applies.
	   A width-only breakpoint can't tell a narrow phone from a shorter/wider
	   landscape one, so this adds orientation to the check specifically to
	   make that distinction. */
	@media (max-width: 860px) and (orientation: portrait) {
		.hero {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-4);
			width: 100%;
		}

		/* Unwraps hero__text so its own children (eyebrow, h1, both
		   paragraphs, actions, social) become direct flex items of .hero
		   alongside hero__photo -- the only way to slot the photo between h1
		   and the first paragraph via `order` below, since `order` only
		   reorders siblings within the same flex container, and on the DOM
		   hero__photo is hero__text's sibling, not its child. display:contents
		   drops hero__text's own box (so its width/gap no longer do anything
		   -- .hero's own gap above takes over that job) without removing it
		   or its children from the document. */
		.hero__text {
			display: contents;
		}

		.eyebrow {
			order: 1;
		}

		.hero__text h1 {
			order: 2;
			max-width: 100%;
			font-size: var(--step-2);
		}

		/* Between the header and the first paragraph, per request -- not at
		   the bottom of the stack, where it used to land simply because it
		   was hero__text's last DOM sibling. */
		.hero__photo {
			order: 3;
			width: 8rem;
			height: 8rem;
			align-self: center;
		}

		h1 + .hero__paragraph {
			order: 4;
			max-width: 100%;
		}

		h1 + .hero__paragraph + .hero__paragraph {
			order: 5;
			max-width: 100%;
		}

		.hero__actions {
			order: 6;
			margin-top: var(--space-2);
		}

		.hero__social {
			order: 7;
		}
	}
</style>
