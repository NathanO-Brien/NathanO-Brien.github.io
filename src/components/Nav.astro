---
interface Props {
	/** Raw inline CSS custom-property overrides, e.g. "--max-width: 71rem; --gutter: 1rem;" */
	navStyle?: string;
}

const { navStyle }: Props = Astro.props;

const links = [
	{ href: "/", label: "About" },
	{ href: "/career/", label: "Career" },
	{ href: "/projects/", label: "Projects" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);
---

<nav class="nav" style={navStyle}>
	<a class="nav__home" href="/">Nathan O'Brien</a>
	<ul class="nav__links">
		{
			links.map((link) => (
				<li>
					<a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		height: var(--nav-height);
		width: 100%;
		max-width: var(--max-width);
		margin-inline: auto;
		padding-inline: var(--gutter, var(--space-5));
	}

	.nav__home {
		font-weight: 600;
		text-decoration: none;
		font-size: var(--step-0);
	}

	.nav__links {
		display: flex;
		gap: var(--space-5);
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: var(--step--1);
	}

	.nav__links a {
		text-decoration: none;
		color: var(--color-muted);
		padding-block: var(--space-1);
		border-bottom: 2px solid transparent;
		transition: color 160ms var(--ease-snap), border-color 160ms var(--ease-snap);
	}

	.nav__links a:hover,
	.nav__links a[aria-current="page"] {
		color: var(--color-ink);
		border-color: var(--color-accent);
	}

	@media (max-width: 480px) {
		.nav {
			padding-inline: var(--space-4);
		}
		.nav__links {
			gap: var(--space-3);
		}
	}
</style>
