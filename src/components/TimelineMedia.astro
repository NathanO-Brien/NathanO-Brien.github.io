---
import DocPreview from "./DocPreview.astro";
import PhotoGallery from "./PhotoGallery.astro";

interface Props {
	id: string;
	title: string;
	pdf?: string;
	gallery?: string[];
}

const { id, title, pdf, gallery = [] } = Astro.props;
const hasContent = Boolean(pdf) || gallery.length > 0;
---

{
	/* Always render this wrapper, even with nothing inside -- it's the
	   positioned anchor hanging off .timeline-row's right edge (see below),
	   so it needs to exist per-entry regardless of whether that entry has
	   any media to show. */
}
<div class="media" data-drop-target={hasContent ? "" : undefined}>
	{gallery.length > 0 && <PhotoGallery images={gallery} id={id} label={title} />}
	{pdf && <DocPreview id={id} href={pdf} label={`Preview: ${title}`} />}
</div>

<style>
	/* Anchored to .timeline-row (the parent), hanging off its right edge,
	   the same way TimelineNode hangs off the left edge -- both track
	   whatever position the tile ends up centered at, rather than living in
	   an independent grid column. Also the "bead drops into its slot"
	   entrance: starts above and slightly shrunk, then overshoots past its
	   resting scale/position and settles back, like a piece landing in a
	   Connect Four column. */
	.media {
		position: absolute;
		top: 0;
		left: calc(100% + var(--space-6));
		width: 18rem;
		opacity: 0;
		transform: translateY(-14px) scale(0.96);
		transition:
			transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 420ms ease-out;
	}

	.media.is-visible {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	@media (prefers-reduced-motion: reduce) {
		.media {
			transition: none;
		}
	}

	@media (max-width: 860px) {
		.media {
			position: static;
			width: 100%;
			margin-top: var(--space-3);
		}
	}
</style>

<script>
	function wireDropIn() {
		const targets = document.querySelectorAll<HTMLElement>("[data-drop-target]:not([data-drop-wired])");
		if (!targets.length) return;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.2, rootMargin: "0px 0px -10% 0px" }
		);

		targets.forEach((el) => {
			el.dataset.dropWired = "true";
			observer.observe(el);
		});
	}

	wireDropIn();
	document.addEventListener("astro:page-load", wireDropIn);
</script>
