---
interface Props {
	category: "education" | "employment" | "award" | "research" | "leadership" | "publications";
	dateRange: string;
}

const { category, dateRange } = Astro.props;
---

<div class="node">
	<div class="node__line" aria-hidden="true"></div>
	<div class="node__marker">
		<span class="node__date">{dateRange}</span>
		<span class={`node__bubble node__bubble--${category}`} aria-hidden="true"></span>
	</div>
</div>

<style>
	/* Anchored to .timeline-row (the parent), not a grid column: hangs off
	   the row's left edge and stretches to the row's full height via
	   top:0;bottom:0, so it tracks whatever height the tile ends up with. */
	.node {
		position: absolute;
		top: 0;
		bottom: 0;
		right: calc(100% + var(--space-6));
		width: 9rem;
	}

	.node__line {
		position: absolute;
		top: 0;
		bottom: 0;
		right: 0.5rem;
		width: 2px;
		/* --color-border is nearly invisible against the dark-mode
		   background; --color-muted has enough contrast in both modes. */
		background: var(--color-muted);
		opacity: 0.4;
		transform: translateX(50%);
	}

	/* Anchored via absolute right:0 (not margin-left:auto on a flex child)
	   so the bubble stays glued to .node__line regardless of how wide the
	   date text is. A date-range string ("2025-08 — Present") is wide
	   enough to overflow the 9rem column; margin-left:auto only pins the
	   right edge while there's free space to consume, so it silently broke
	   for ranges while single dates (awards) stayed fine by coincidence.
	   Absolute positioning has no such free-space dependency: the marker's
	   right edge is always at .node's right edge, and the date text simply
	   grows leftward as needed without moving the bubble. */
	.node__marker {
		position: absolute;
		z-index: 1;
		right: 0;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.node__date {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--color-muted);
		white-space: nowrap;
	}

	.node__bubble {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		border-radius: 999px;
		box-shadow: 0 0 0 4px var(--color-bg);
	}

	.node__bubble--employment {
		background: var(--color-timeline-employment);
	}

	.node__bubble--education {
		background: var(--color-timeline-education);
	}

	.node__bubble--award {
		background: var(--color-timeline-award);
	}

	.node__bubble--research {
		background: var(--color-timeline-research);
	}

	.node__bubble--leadership {
		background: var(--color-timeline-leadership);
		border: 1px solid var(--color-border);
	}

	.node__bubble--publications {
		background: var(--color-timeline-publications);
	}

	@media (max-width: 860px) {
		.node {
			position: static;
			width: auto;
			padding-bottom: var(--space-3);
		}

		.node__line {
			display: none;
		}

		.node__marker {
			position: static;
			transform: none;
		}
	}
</style>
