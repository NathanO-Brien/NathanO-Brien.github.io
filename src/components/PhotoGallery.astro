---
interface Props {
	images: string[];
	/** Unique id suffix so multiple galleries can live on one page. */
	id: string;
	/** Used as alt-text prefix, e.g. "Georgia Tech orientation". */
	label: string;
}

const { images, id, label } = Astro.props;
---

{
	images.length > 0 && (
		<div class="gallery">
			{images.map((src, i) => (
				<>
					<button
						type="button"
						class="gallery__thumb"
						data-dialog={`gallery-${id}-${i}`}
						aria-label={`Open photo ${i + 1} of ${label}`}
					>
						<img src={src} alt={`${label} — photo ${i + 1}`} loading="lazy" />
					</button>
					<dialog id={`gallery-${id}-${i}`} class="gallery-modal">
						<button
							type="button"
							class="gallery-modal__close"
							data-close={`gallery-${id}-${i}`}
							aria-label="Close photo"
						>
							✕
						</button>
						<img src={src} alt={`${label} — photo ${i + 1}`} />
					</dialog>
				</>
			))}
		</div>
	)
}

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-2);
	}

	.gallery__thumb {
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		overflow: hidden;
		cursor: pointer;
		background: var(--color-surface);
		aspect-ratio: 4 / 3;
		transition: border-color 160ms var(--ease-snap), transform 160ms var(--ease-snap);
	}

	.gallery__thumb:hover,
	.gallery__thumb:focus-visible {
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}

	.gallery__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.gallery-modal {
		border: none;
		border-radius: var(--radius-lg);
		padding: 0;
		max-width: min(90vw, 60rem);
		max-height: 85vh;
		box-shadow: var(--shadow-md);
		background: var(--color-surface);
	}

	.gallery-modal::backdrop {
		background: rgba(10, 10, 12, 0.55);
	}

	.gallery-modal img {
		display: block;
		max-width: min(90vw, 60rem);
		max-height: 85vh;
		object-fit: contain;
	}

	.gallery-modal__close {
		position: absolute;
		top: var(--space-3);
		right: var(--space-3);
		border: none;
		border-radius: 999px;
		width: 2rem;
		height: 2rem;
		background: rgba(10, 10, 12, 0.55);
		color: #fff;
		cursor: pointer;
		line-height: 1;
	}
</style>

<script>
	function wireUpGalleryDialogs() {
		document.querySelectorAll<HTMLButtonElement>("[data-dialog]").forEach((trigger) => {
			const dialog = document.getElementById(trigger.dataset.dialog!) as HTMLDialogElement | null;
			if (!dialog || trigger.dataset.wired) return;
			trigger.dataset.wired = "true";
			trigger.addEventListener("click", () => dialog.showModal());
			dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
			dialog.addEventListener("click", (event) => {
				if (event.target === dialog) dialog.close();
			});
		});
	}

	wireUpGalleryDialogs();
	document.addEventListener("astro:page-load", wireUpGalleryDialogs);
</script>
