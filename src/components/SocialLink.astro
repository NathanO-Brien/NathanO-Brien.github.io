---
interface Props {
	label: string;
	href: string;
	icon: "linkedin" | "github" | "email";
}

const { label, href, icon } = Astro.props;

const icons: Record<Props["icon"], string> = {
	linkedin:
		'<path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.22 8.24h4.56V23H.22V8.24zM8.46 8.24h4.37v2.01h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v8.11h-4.56v-7.19c0-1.72-.03-3.93-2.39-3.93-2.4 0-2.77 1.87-2.77 3.8v7.32H8.46V8.24z"/>',
	github:
		'<path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.21.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>',
	email:
		'<path d="M1.5 4.5A1.5 1.5 0 0 1 3 3h18a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 21 21H3a1.5 1.5 0 0 1-1.5-1.5v-15zm2.4.9 8.1 6.3 8.1-6.3H3.9zm16.1 1.68-8.03 6.24-8.03-6.24V19.5h16.06V7.08z"/>',
};
---

<a class="social" href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label}>
	<svg viewBox="0 0 24 24" fill="currentColor" set:html={icons[icon]} />
</a>

<style>
	.social {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		color: var(--color-muted);
		background: var(--color-surface);
		transition: transform 160ms var(--ease-snap), color 160ms var(--ease-snap),
			border-color 160ms var(--ease-snap);
	}

	.social svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.social:hover,
	.social:focus-visible {
		color: var(--color-accent);
		border-color: var(--color-accent);
		transform: translateY(-2px);
	}
</style>
